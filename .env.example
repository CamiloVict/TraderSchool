# Binance SPOT Testnet API credentials.
# Create an account and generate keys at https://testnet.binance.vision/
# (log in with GitHub, then "Generate HMAC_SHA256 Key").
# Never commit your real .env file — it is already in .gitignore.
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here

# Keep this "true" until the bot has been fully backtested and you
# understand the risks. It must be explicitly set to "false" before
# any code path is allowed to touch a real account.
BINANCE_TESTNET=true

# Market parameters (optional overrides of the defaults in config.py).
# PAXG/USDT (oro) is the default focus of this bot; set SYMBOL=BTC/USDT
# here if you want to trade/backtest BTC instead.
SYMBOL=PAXG/USDT
TIMEFRAME=1h

# Opt-in reversal-pattern confirmation filter (double-top/bottom,
# head-and-shoulders/inverse, triangles — see patterns.py) for live
# trading. Backtest it with `python backtester.py --pattern-filter`
# before turning this on — it's off by default.
USE_PATTERN_FILTER=false

# Opt-in: replace the EMA crossover with context_engine's Setup Engine
# (LIQUIDITY_SWEEP_RECLAIM) as the only reason main.py --trade enters —
# see the "Setup Engine y Market State Machine" section of the README
# before turning this on. Off by default; never tested against a live
# Testnet feed, only this repo's own test suite.
USE_SETUP_ENGINE=false
# Days of 1h history fetched (from real Binance, public data) to build
# multi-timeframe context when USE_SETUP_ENGINE is on. Only read then.
CONTEXT_HISTORY_DAYS=540

# Opt-in notifications (see notifier.py) for main.py --trade's outcomes
# (buy/sell, entries blocked, failures) -- both empty means --trade
# stays silent except for logs/trading.log, same as before this existed.
# Telegram: create a bot via @BotFather to get a token, then message
# your bot once and check https://api.telegram.org/bot<token>/getUpdates
# for your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Generic webhook (a Slack incoming webhook URL, a Discord webhook URL,
# or anything else that accepts a POSTed JSON body) -- an alternative
# or addition to Telegram above.
ALERT_WEBHOOK_URL=
